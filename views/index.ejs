<% layout("/layouts/boilerplate") %>
<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mt-3">
                                                                                                                                                     // LISTING img
                                                                                                                                                     //title
                                                                                                                                                     //LOCATION,country
                                                                                                                                                     //PRICE
                                                                                                                                                
    <% for(let listing of alllist) { %>
        <div class="col">
            
            <div class="card h-100 border-0 listing-card">
                
                <img src="<%= listing.image.url %>" class="card-img-top rounded-4" alt="Property Image" style="height: 20rem; object-fit: cover;">
                
                <div class="card-body px-0 pt-3">
                    <h5 class="card-title fw-bold mb-1">
                        <a href="/listings/<%= listing._id %>" class="text-decoration-none text-dark">  //link to the respective list i want to open
                            <%= listing.title %>
                        </a>
                    </h5>
                    
                    <p class="card-text text-muted mb-1">
                        <%= listing.location %>, <%= listing.country %>
                    </p>
                    
                    <p class="card-text">
                        <span class="fw-bold">&#8377; <%= listing.price.toLocaleString("en-IN") %></span> / night   //conerting the price in INR terms with rupees and commas
                    </p>
                </div>
                
            </div>
            
        </div>
    <% } %>

</div>
<h3>WANT TO ADD A LISTING BREV ?</h3>
<a href="/listings/new"><button>NEW</button></a>